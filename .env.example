# Multi-Source Data Agent core runtime configuration
# Default product stack: Backend + MySQL + Neo4j + PostgreSQL/PGVector + kb_ingest.

APP_NAME=Multi-Source Data Agent
APP_VERSION=0.1.2
DEBUG=True
MULTISOURCE_AGENT_DEBUG=True

# API
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Main LLM
LLM_PROVIDER=openai
LLM_MODEL=qwen-max
LLM_API_KEY=replace_with_your_provider_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.7

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=replace_with_your_provider_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

# Reranker
RERANK_ENABLED=true
RERANK_PROVIDER=custom
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services
RERANK_ENDPOINT=/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=replace_with_your_provider_key
RERANK_MAX_CANDIDATES=20
RERANK_TOP_N=6
RERANK_TIMEOUT=30
RERANK_SCORE_FUSION_ALPHA=0.5

# MySQL business database
MYSQL_ROOT_PASSWORD=local_demo_root_only
MYSQL_DATABASE=retail_demo
MYSQL_USER=retail_user
MYSQL_PASSWORD=local_demo_only
DATABASE_URL=mysql+pymysql://retail_user:local_demo_only@mysql:3306/retail_demo
SQL_AGENT_MAX_ROWS=200
SQL_AGENT_TIMEOUT_MS=5000

# Neo4j graph tool
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local_demo_only
NEO4J_DEFAULT_GRAPH_QUERY=MATCH (a)-[r]-(b) RETURN a, r, b LIMIT 100

# Agent
MAX_ITERATIONS=10
AGENT_TIMEOUT=300
ROUTER_TIMEOUT_SECONDS=60
CORE_TOOL_TIMEOUT_SECONDS=100
MULTISOURCE_AGENT_MEMORY_TURNS=5

# Canonical Knowledge RAG (backend -> kb_ingest -> PGVector + reranker)
KB_TOP_K=5
KB_SIMILARITY_THRESHOLD=0.2
KB_POSTGRES_SIMILARITY_THRESHOLD=0.5
KB_POSTGRES_RERANK_THRESHOLD=0.8
KB_PGVECTOR_REQUEST_TIMEOUT=45
KB_RERANK_SCORE_THRESHOLD=0.8
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=80

# kb_ingest LLM
KB_LLM_PROVIDER=openai
KB_LLM_MODEL=qwen-max
KB_LLM_API_KEY=replace_with_your_provider_key
KB_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KB_LLM_TEMPERATURE=0.3
KB_USE_LLM=true

# kb_ingest embedding
KB_EMBEDDING_PROVIDER=openai
KB_EMBEDDING_MODEL=text-embedding-v4
KB_EMBEDDING_API_KEY=replace_with_your_provider_key
KB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KB_EMBEDDING_DIMENSION=1024

# kb_ingest reranker
KB_RERANK_ENABLED=true
KB_RERANK_PROVIDER=custom
KB_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services
KB_RERANK_ENDPOINT=/rerank/text-rerank/text-rerank
KB_RERANK_API_KEY=replace_with_your_provider_key
KB_RERANK_MODEL=qwen3-rerank
KB_RERANK_TIMEOUT=30
KB_RERANK_MAX_CANDIDATES=20
KB_RERANK_TOP_N=6
KB_RERANK_SCORE_FUSION_ALPHA=0.5

# PGVector ingestion service
INGEST_SERVICE_URL=http://localhost:8100
BACKEND_INGEST_SERVICE_URL=http://kb_ingest:8000
INGEST_INCREMENTAL_DEFAULT=true
FILE_UPLOAD_MAX_MB=2

# Chat/session infrastructure
CONVERSATION_HISTORY_TTL=259200
CONVERSATION_HISTORY_MAX_MESSAGES=200

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
